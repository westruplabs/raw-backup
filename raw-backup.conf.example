# raw-backup configuration  (~/.config/raw-backup.conf)
# This file is not overwritten when you update the script.

# ---------------------------------------------------------------------------
# Backup jobs - one per line:
#
#     source folder  |  drive name  |  folder on the drive
#
#   source folder        the folder to back up (~ means your home folder)
#   drive name           the USB drive's name as shown in Finder
#   folder on the drive  where the copy goes; leave it out to use the source
#                        folder's name, or use . for the top level of the drive
#
# Several folders can go to the same drive, and the same folder can go to
# several drives. Every job whose drive is plugged in runs automatically.
# Lines starting with # are ignored.
# ---------------------------------------------------------------------------
JOBS='
~/Pictures/Raw      | USB_1TB   | Raw
# ~/Documents/Work  | USB_1TB   | Work
# ~/Pictures/Raw    | BACKUP_2  | Raw
'

# Read back the entire copy and compare checksums every N days, per job.
# Takes roughly as long as reading the whole copy. 0 = never automatically.
FULL_VERIFY_DAYS=30

# Eject the drive automatically when all its jobs succeeded
EJECT_WHEN_DONE=false

# Show macOS notifications
NOTIFY=true
