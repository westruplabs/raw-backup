# Inställningar för raw-backup. Ligger i ~/.config/raw-backup.conf
# och skrivs inte över när skriptet uppdateras.

# Mappen som ska säkerhetskopieras
SRC="$HOME/WORK/Raw"

# USB-minnets namn (som det heter i Finder)
VOLUME_NAME="USB_1TB"

# Mapp på USB-minnet där kopian hamnar
DEST_SUBDIR="Raw"

# Läs tillbaka HELA kopian och jämför checksummor var N:e dag (0 = aldrig automatiskt).
# Tar tid: ungefär lika lång tid som att läsa hela minnet.
FULL_VERIFY_DAYS=30

# Mata ut USB-minnet automatiskt när backupen gått bra
EJECT_WHEN_DONE=false

# Visa notiser i macOS
NOTIFY=true
