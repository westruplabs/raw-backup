# raw-backup configuration  (~/.config/raw-backup.conf)
# This file is not overwritten when you update the script.

# ---------------------------------------------------------------------------
# Backup jobs - one per line:
#
#     source folder  |  drive name  |  folder on the drive
#
#   source folder        the folder to back up (~ means your home folder)
#   drive name           the USB drive's name as shown in Finder,
#                        or a NAS share: smb://server/share
#   folder on the drive  where the copy goes; leave it out to use the source
#                        folder's name, or use . for the top level of the drive
#
# Several folders can go to the same drive, and the same folder can go to
# several drives. Every job whose drive is plugged in runs automatically.
# Lines starting with # are ignored.
# ---------------------------------------------------------------------------
JOBS='
~/Pictures/Raw      | USB_1TB   | Raw
# ~/Documents/Work  | USB_1TB   | Work
# ~/Pictures/Raw    | BACKUP_2  | Raw
# ~/Pictures/Raw    | smb://mynas.local/backup | Photos/Raw
'

# Read back the entire copy and compare checksums every N days, per job.
# Takes roughly as long as reading the whole copy. 0 = never automatically.
FULL_VERIFY_DAYS=30

# Eject the drive automatically when all its jobs succeeded
EJECT_WHEN_DONE=false

# Show macOS notifications
NOTIFY=true

# ---------------------------------------------------------------------------
# NAS jobs (lines with smb://...) run after the USB backup:
#   ask   show a question with the size of the upload - answer "Not now" on a
#         slow connection (default)
#   auto  upload without asking whenever the NAS can be reached
#   off   never automatically - only when you run: raw-backup.sh --nas
# If the NAS cannot be reached it is skipped quietly. Save the NAS password in
# the keychain the first time you connect in Finder.
# ---------------------------------------------------------------------------
NAS_UPLOAD=ask

# Seconds to wait for an answer. No answer = skip the NAS this time.
NAS_ASK_TIMEOUT=120

# Full read-back check of the NAS copies every N days. This reads the whole
# copy over the network, so it is off by default (0); run it yourself with
# raw-backup.sh --nas --verify-all
NAS_FULL_VERIFY_DAYS=0

# Read each file back from the NAS right after uploading it, to check it.
# Over the internet this can almost double the upload time. With false, only
# the size is checked during upload; the checksum of the original is still
# saved, so raw-backup.sh --nas --verify-all checks the NAS copy properly
# whenever you run it (preferably on a fast connection).
# USB drives are always checked right after copying.
NAS_VERIFY_AFTER_COPY=true
